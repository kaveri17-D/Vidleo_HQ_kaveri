# ==============================================================================
# VIDLEO WEBSITE - ENVIRONMENT VARIABLES EXAMPLE
# Rename this file to .env.local and populate with your environment secrets.
# DO NOT COMMIT YOUR REAL .env.local FILE TO GIT OR PUBLIC REPOSITORIES.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE AUTHENTICATION & DATABASE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (Required ONLY for administrative tasks on the server-side)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# OPTIONAL API & ENGINE ENDPOINTS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VIDLEO_API_URL=https://api.vidleo.app

# ------------------------------------------------------------------------------
# INITIAL ADMIN USER FALLBACK (OPTIONAL)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@vidleo.app
